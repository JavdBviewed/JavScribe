# ---------- Python ----------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
venv/
.python-version.local

# ---------- 模型权重（永不进仓库） ----------
models/
**/models/
*.gguf
*.onnx
*.safetensors
# 注: *.bin 已通过 .gitattributes 标记 binary；CT2 模型目录(含 model.bin)
# 若误放进工作区，用下面的目录规则兜底
hainan*/
chickenrice-models/

# ---------- 本地机器相关配置 ----------
config/*.local.json
config/*-local.json
.env
.env.*

# ---------- 运行时产物 ----------
*.opus
*.tmp
*.bak
inbox/
*.log
logs/

# ---------- 媒体文件（误拖进工作区时兜底） ----------
*.mp4
*.mkv
# 注意: *.ts 会误伤 TypeScript 源码，下面逐一否定回来
*.ts
!client/**/*.ts
!scripts/**/*.ts
!vite.config.ts
!playwright.config.ts
!vite.desktop.config.ts
!playwright.desktop.config.ts
*.m2ts
*.mov
*.avi
*.webm
*.mp3
*.flac
*.m4a
*.aac

# ---------- e2e 测试夹具（故意提交的媒体小文件） ----------
!client/tests/e2e/fixtures/**

# ---------- Node / 前端工具 ----------
node_modules/
test-results/
test-results-desktop/
playwright-report/
playwright-report-desktop/

# ---------- 桌面端构建产物（pnpm build:desktop 生成） ----------
client/dist-desktop/
# build-desktop.mjs 的临时输入（titlebar 注入前的 brand mark 资产 + 临时 html）
client/favicon.png
client/index-desktop.html

# ---------- IDE / 系统 ----------
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db
Desktop.ini

# ---------- 桌面端打包（三期） ----------
