+def run_server(args):
+    """[JavScribe] Server mode: resident model + stdin JSON batch protocol.
+
+    Protocol (newline-delimited; stdout progress lines are identical to CLI
+    so JavScribe serve's LogParser stays compatible):
+      stdin  line: {"files": ["/abs/path.audio", ...]}
+      stdout: "[SERVER] ready pid=<pid>"       after model load
+      stdout: "[SERVER] batch_done files=<n>"  after each batch
+      stdout: "[SERVER] batch_error <msg>"     on bad request line
+    Idle: no stdin line within keepalive_s (0 = never) -> exit 0 (release).
+    stdin EOF -> exit 0. A per-file failure crashes the process like CLI
+    mode does; the caller (JavScribe serve) respawns on next need.
+    """
+    import json as _json
+    import queue as _queue
+    import threading as _threading
+
+    inference = Inference(args)
+    inference.ensure_model()
+    print("[SERVER] ready pid={}".format(os.getpid()), flush=True)
+
+    q = _queue.Queue()
+
+    def _reader():
+        try:
+            for line in sys.stdin:
+                q.put(line)
+        except Exception:  # noqa: BLE001 - reader must never kill the server
+            pass
+        q.put(None)  # EOF sentinel
+
+    _threading.Thread(target=_reader, daemon=True).start()
+    keepalive = max(0, args.keepalive_s)
+
+    while True:
+        try:
+            line = q.get(timeout=keepalive if keepalive > 0 else None)
+        except _queue.Empty:
+            logger.info("[JavScribe] server idle keepalive timeout (%ss) - releasing model", keepalive)
+            print("[SERVER] idle_exit", flush=True)
+            sys.exit(0)
+        if line is None:
+            logger.info("[JavScribe] server stdin EOF - exiting")
+            sys.exit(0)
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            req = _json.loads(line)
+        except _json.JSONDecodeError as e:
+            print("[SERVER] batch_error bad_json: {}".format(e), flush=True)
+            continue
+        files = [str(f) for f in (req.get("files") or [])]
+        tasks = inference._scan(files) if files else []
+        n_done = len(tasks)
+        if tasks:
+            inference.transcribe_tasks(tasks)
+        print("[SERVER] batch_done files={}".format(n_done), flush=True)
+
+
