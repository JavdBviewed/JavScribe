+    def _fallback_clip_timestamps(self, audio: Any, *, batched: bool) -> list[Any]:
+        """Clip list for when the enhanced VAD finds no speech.
+
+        Order: built-in Silero VAD -> full-file coverage (batched only;
+        the non-batched pipeline already treats an empty list as "full
+        audio").
+
+        When the full-file coverage branch is reached (no VAD found any
+        speech), _skip_batch_this_file is set so the caller avoids the
+        batched attempt for this file.
+        """
+        if not batched:
+            return []
+        try:
+            from faster_whisper.vad import VadOptions, get_speech_timestamps
+
+            silero_segments = get_speech_timestamps(audio, VadOptions(max_speech_duration_s=30))
+            if silero_segments:
+                clips = [
+                    {"start": float(s["start"]), "end": float(s["end"])} for s in silero_segments
+                ]
+                logger.warning(
+                    "Enhanced VAD found no speech segments; using built-in Silero VAD "
+                    f"({len(clips)} clips, {int(sum(c['end'] - c['start'] for c in clips))}s of speech). "
+                    "Check the VAD threshold in the JavScribe service settings."
+                )
+                return clips
+        except Exception as e:
+            logger.warning(f"Silero VAD fallback failed: {e}; using full-file coverage")
+        logger.warning(
+            "No speech detected by any VAD; using full-file coverage and skipping "
+            "batched inference for this file (unreliable on continuous audio)"
+        )
+        self._skip_batch_this_file = True
+        return [{"start": 0, "end": len(audio)}]
+
